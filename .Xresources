!if __has_includs(".extend.Xresources")
! new_theme

! special
*.foreground:   #bbbbbb
*.background:   #000000
*.cursorColor:  #ffffff

! black
*.color0:       #000000
!___empty_color
*.color8:       #2d2d2d

! red
!___main_color
*.color1:       #e44142
*.color9:       #e3a3a3

! green
*.color2:       #aaaaaa
*.color10:      #aaaaaa

! yellow
!___secondary_color
*.color3:       #dada69
*.color11:      #ffffff

! blue
*.color4:       #999999
*.color12:      #999999

! magenta
*.color5:       #ffffff
*.color13:      #ffffff

! cyan
*.color6:       #ffffff
*.color14:      #ffffff

! white
*.color7:       #ffffff
*.color15:      #ffffff



!___cool_colors
!#e48641


!___MyConfig________________________________________________________________

! Font
# URxvt.font:xft:Hack Nerd Font Mono:size=14
# URxvt.boldFont:xft:Hack Nerd Font Mono:size=14
URxvt.font:xft:JetBrainsMono Nerd Font:size=14
URxvt.boldFont:xft:JetBrainsMono Nerd Font:size=14

! Space chars lines
URxvt.letterSpace: -1
URxvt.lineSpace: -2
URxvt.geometry: 92x24

! Cursor
URxvt.curosrBlink: 1
URxvt.cursorColor: #647b83
URxvt.curosrUnderline: 1
URxvt.cursorShape: |

! Cursor theme
Xcursor.theme: whiteglass
Xcursor.size: 24

! Pointer
URxvt.pointerBlank: true

! ScrollBar
URxvt.scrollBar: false

!URxvt.internalBorder: 6
!internalBorder



!___disable_keys___

!___Other________________________________________________________________



