# exec feh --bg-scale /usr/share/backgrounds/mountain_clouds_wallpaper_1920x1080.jpg
# exec feh --bg-scale $wallpaper
exec feh --bg-center $wallpaper

#___i3_Gaps_________
gaps inner 0
gaps outer 0
smart_gaps on

#___app_lunch_key_binds_________
bindsym Ctrl+space exec "sh ~/.config/rofi/launchers/type-2/launcher.sh"
bindsym $mod+Ctrl+space exec "sh ~/.config/rofi/launchers/type-1/launcher.sh"

#___language_setting_________
#___mode_f1_for_eng
bindcode $mod+67 exec "setxkbmap us"
#___mode_f2_for_ar
bindcode $mod+68 exec "setxkbmap ara"


#___screen_capture_________
#___Capture_full_screen_and_save_to_Pictures
bindsym Print exec --no-startup-id maim ~/Pictures/$(date +%F-%T).png

#___Select_a_region_or_window_and_save_to_Pictures
bindsym Shift+Print exec --no-startup-id maim -s ~/Pictures/$(date +%F-%T).png

#___Select_a_region_and_copy_directly_to_clipboard_(requires_xclip)
bindsym $mod+Shift+s exec --no-startup-id maim -s | xclip -selection clipboard -t image/png

