general {
	output_format = "i3bar"
	colors = true
	#color_good = "#a3be8c"
	#color_bad = "#bf616a"
	interval = 5
	separator = "|"
}


order += "disk /"	
order += "memory"
order += "load"
order += "tztime local"
order += "battery all"

load {
	format = " %1min  "
}

memory {
	format = "   %used "
	threshold_degraded = "  10%  "
        format_degraded = "  MEMORY: %free  "
}

disk "/" {
	format = "   %free free  "
}

tztime local {
        format = "   %d-%m   %H:%M  "
}

battery all {
    format = " %status %percentage %remaining "
	last_full_capacity = true
    format_down = " No battery "
    status_chr = " ⚡ CHR "
    status_bat = "    BAT "
    status_unk = " ? UNK "
    status_full = " ☻ FULL "
    path = "/sys/class/power_supply/BAT%d/uevent"
    low_threshold = 10
}
